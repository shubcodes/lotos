# Server
PORT=4000
LOG_LEVEL=info

# Postgres
DATABASE_URL=postgres://lotos:lotos@localhost:5432/lotos

# Storage
STORAGE_PROVIDER=local
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=lotos-lots
S3_ACCESS_KEY=minio
S3_SECRET_KEY=miniosecret

# Kubernetes
KUBECONFIG=~/.kube/config
K8S_NAMESPACE=default

# Features
ENABLE_LOCAL_RUNTIME=true
RUNTIME_TIMEOUT_MS=60000
